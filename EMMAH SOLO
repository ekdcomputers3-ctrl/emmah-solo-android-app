/* FOOTER */
footer {
    text-align: center;
    padding: 30px 10px;
    color: #777777;
    font-family: Arial, sans-serif;
    font-size: 12px;
}

/* BOTTOM NAVIGATION */
.bottom-nav {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    height: 70px;
    background: #080808;
    border-top: 1px solid #725d20;
    display: flex;
    justify-content: space-around;
    align-items: center;
    z-index: 1000;
}

.nav-item {
    text-align: center;
    color: #999999;
    font-family: Arial, sans-serif;
    font-size: 11px;
    cursor: pointer;
}

.nav-item span {
