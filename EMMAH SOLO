<style>
* {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
}

html {
    scroll-behavior: smooth;
}

body {
    font-family: Georgia, "Times New Roman", serif;
    background: #0b0b0b;
    color: #ffffff;
    padding-bottom: 80px;
}

/* HEADER */
header {
    text-align: center;
    padding: 42px 18px 35px;
    background:
        radial-gradient(circle at top, #3b301c, #15130f 45%, #080808 100%);
    border-bottom: 2px solid #d4af37;
}

.logo {
    color: #d4af37;
    font-size: 29px;
    font-weight: bold;
    letter-spacing: 1px;
}

.subtitle {
    margin-top: 12px;
    font-size: 19px;
    letter-spacing: 4px;
}

.tagline {
    margin-top: 13px;
    color: #cfcfcf;
    font-style: italic;
}

/* CONTENT */
.container {
    max-width: 1000px;
    margin: auto;
    padding: 20px;
}

.welcome {
    text-align: center;
    padding: 30px 10px;
}

.welcome h2 {
    color: #d4af37;
    margin-bottom: 14px;
}

.welcome p {
    color: #dddddd;
    line-height: 1.8;
}

/* SECTION TITLES */
.section-title {
    text-align: center;
    color: #d4af37;
    margin: 28px 0 20px;
}

/* GUITAR CARDS */
.lessons {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 20px;
}

.card {
    background: linear-gradient(145deg, #202020, #111111);
    border: 1px solid #725d20;
    border-radius: 18px;
    overflow: hidden;
    box-shadow: 0 10px 28px rgba(0,0,0,0.55);
    transition: transform 0.2s;
}

.card:hover {
    transform: translateY(-4px);
}

.guitar-image {
    height: 220px;
    display: flex;
    align-items: center;
    justify-content: center;
    background:
        radial-gradient(circle, #39301e, #151515 70%);
    font-size: 100px;
}

.card-content {
    padding: 20px;
}

.card h3 {
    color: #d4af37;
    font-size: 23px;
    margin-bottom: 10px;
}

.card p {
    color: #dddddd;
    line-height: 1.65;
}

.price {
    color: #d4af37;
    font-size: 20px;
    font-weight: bold;
    margin-top: 15px;
}

.time {
    color: #cccccc;
    margin-top: 6px;
}

/* LEARNING */
.skills {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 14px;
}

.skill {
    background: #191919;
    border-left: 3px solid #d4af37;
    padding: 18px;
    border-radius: 10px;
}

.skill h3 {
    color: #d4af37;
    margin-bottom: 8px;
}

.skill p {
    color: #cccccc;
    line-height: 1.5;
}

/* PROFESSOR */
.professor {
    margin-top: 35px;
    padding: 28px 20px;
    text-align: center;
    background: linear-gradient(145deg, #302718, #111111);
    border: 1px solid #d4af37;
    border-radius: 18px;
}

.professor-icon {
    font-size: 65px;
    margin-bottom: 10px;
}

.professor h2 {
    color: #d4af37;
    margin-bottom: 10px;
}

.professor p {
    color: #dddddd;
    line-height: 1.7;
}

/* BOOKING */
.booking {
    margin-top: 30px;
    padding: 30px 20px;
    text-align: center;
    background: #171717;
    border: 1px solid #725d20;
    border-radius: 18px;
}

.booking h2 {
    color: #d4af37;
    margin-bottom: 12px;
}

.whatsapp {
    display: inline-block;
    margin-top: 20px;
    padding: 14px 27px;
    background: #25D366;
    color: #ffffff;
    text-decoration: none;
    border-radius: 30px;
    font-family: Arial, sans-serif;
    font-weight: bold;
